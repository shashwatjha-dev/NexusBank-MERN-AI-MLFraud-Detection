# --- NexusBank ML service — local development ---
# Copy this file to `.env` in the same folder.

ENV=development

# HTTP interface
HOST=0.0.0.0
PORT=8000

# CORS: comma-separated allow-list. The Node.js backend runs on 5000.
CORS_ORIGINS=http://localhost:5000

# Model artifact directory (relative to the ml-service folder).
MODEL_DIR=./models

# Optional override. Leave blank to auto-pick the newest model in MODEL_DIR.
MODEL_VERSION=

# Fraud decision threshold on the predicted probability. Keep at 0.5 unless
# you deliberately want to bias precision or recall.
PREDICTION_THRESHOLD=0.5

# Training-time configuration (only used by `python -m training.train`).
TRAIN_DATASET_SIZE=50000
TRAIN_FRAUD_RATE=0.08
TRAIN_RANDOM_SEED=42
TRAIN_TEST_SPLIT=0.2