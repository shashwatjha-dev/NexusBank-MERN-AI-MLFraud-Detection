# --- NexusBank Backend — local development ---
# Copy this file to `.env` in the same folder and fill in real values.

NODE_ENV=development
PORT=5000

# MongoDB (local Mongo running on the default port).
MONGO_URL=mongodb://localhost:27017
DB_NAME=nexusbank

# JWT signing. Use a long, random string. Never commit real secrets.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-48-byte-random-hex-string
JWT_EXPIRES_IN=2h

# Comma-separated CORS allow-list. Vite defaults to 5173, CRA to 3000.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Python ML service (Phase 3). Leave EMPTY until you start ml-service.
# Example when ml-service is running:  http://localhost:8000
ML_SERVICE_URL=

# --- Email / OTP (Phase 5, Batch 3) ---
# NexusBank sends OTP emails via SMTP. For local development use Mailtrap
# (https://mailtrap.io -> Inboxes -> SMTP Settings) or a Gmail App Password.
# Leave SMTP_HOST empty to disable real email delivery — in that case the
# demoOtp field in the API response is still populated in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="NexusBank <no-reply@nexusbank.dev>"

# OTP tuning
OTP_RESEND_COOLDOWN_SECONDS=60
# --- PPF Simulation (Phase 5, Batch 5) ---
# NexusBank PPF is a portfolio simulation. Not a real Government of India PPF.
PPF_INTEREST_RATE=7.1
PPF_ANNUAL_LIMIT_PAISE=15000000
PPF_MIN_CONTRIBUTION_PAISE=50000
# Demo time-scale: how many REAL months represent one PPF year.
# 12 = real time (15-year PPF matures in 15 years).
# 1  = compressed demo (15-year PPF matures in 15 months).
PPF_DEMO_TIME_SCALE_MONTHS_PER_YEAR=1